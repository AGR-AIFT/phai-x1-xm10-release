# Build output (로컬 빌드 시)
Debug/
Release/
build/
!**/tools/build/

# 패키징 산출물 — GitHub Release 에 업로드 후 로컬 보관 불필요
# (tools/package_release.ps1 가 레포 루트에 생성)
/Rev*.zip
/AGR_Bootloader.bin
/SUIT_*.bin
/SUIT_*.zip
/ContentsFiles_*.zip

# Claude Code — 개발자 개인 설정 ignore, 학생용 공개 skill 만 추적
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/student-onboard/
!.claude/skills/example-helper/

# clangd (LSP 인덱스 캐시 & 설정)
.cache/
.clangd

# VS Code — 개인 환경 경로 ignore, 템플릿만 추적 (.template 는 추적됨)
.vscode/settings.json

